})();
window.LAYOUT = (function () {
  'use strict';
  const C = {
    W: 248, H: 92,
    GX: 28,           // entre ramos irmãos
    GY: 56,           // do pé do cartão até a linha dos filhos
    TRILHO: 16,       // distância do trilho até a borda esquerda da coluna
    RECUO: 40,        // onde começa o cartão pendurado (o trilho fica no recuo)
    LINHA: 12,        // entre cartões pendurados
    COLUNA: 24,       // entre colunas penduradas
    PENDURA: 24,      // do pé do líder até o começo das colunas
    TOPO: 12,         // folga entre a barra que une as colunas e o primeiro cartão
    LINHAS_MAX: 10,   // cartões por coluna antes de abrir outra coluna
    QUEBRA: 6,        // ramos por linha antes de quebrar em mais linhas (compacto)
    MISTO_MIN: 3,     // líder com equipe E sublíderes: a equipe vira coluna a partir de 3
    RAIO: 7           // curva das quinas dos fios
  };
  function calcular(op) {
    const caixas = new Map();
    const compacto = op.modo === 'compacto';
    function colunas(folhas) {
      const k = Math.ceil(folhas.length / C.LINHAS_MAX);
      const porColuna = Math.ceil(folhas.length / k);
      const cols = [];
      for (let i = 0; i < folhas.length; i += porColuna) cols.push(folhas.slice(i, i + porColuna));
      return cols;
    }
    function bloco(folhas) {
      const cols = colunas(folhas);
      const maior = Math.max(...cols.map(c => c.length));
      return {
        tipo: 'bloco', cols,
        w: cols.length * (C.RECUO + C.W) + (cols.length - 1) * C.COLUNA,
        h: C.TOPO + maior * C.H + (maior - 1) * C.LINHA,
        ax: C.TRILHO
      };
    }
    function item(no) { const c = medir(no); return { tipo: 'no', no, w: c.w, h: c.h, ax: c.cx + C.W / 2 }; }
    function medir(no) {
      const filhos = op.filhos(no);
      let c;
      if (!filhos.length) c = { tipo: 'so', w: C.W, h: C.H, cx: 0 };
      else if (compacto && filhos.every(op.folha)) c = pendurado(filhos);
      else {
        const folhas = filhos.filter(op.folha), ramos = filhos.filter(f => !op.folha(f));
        const itens = ramos.map(item).concat(compacto && folhas.length >= C.MISTO_MIN ? [bloco(folhas)] : folhas.map(item));
        c = compacto && itens.length > C.QUEBRA ? emLinhas(itens) : emLinha(itens);
      }
      caixas.set(no.id, c);
      return c;
    }
    function pendurado(folhas) {
      const b = bloco(folhas);
      b.dx = 0; b.dy = C.H + C.PENDURA;
      return { tipo: 'pendurado', bloco: b, w: Math.max(C.W, b.w), h: C.H + C.PENDURA + b.h, cx: 0 };
    }
    function emLinha(itens) {
      let x = 0;
      itens.forEach(it => { it.dx = x; it.dy = C.H + C.GY; x += it.w + C.GX; });
      const largura = x - C.GX;
      const centro = (itens[0].dx + itens[0].ax + itens[itens.length - 1].dx + itens[itens.length - 1].ax) / 2;
      let cx = centro - C.W / 2;
      const esq = Math.min(0, cx), dir = Math.max(largura, cx + C.W);
      itens.forEach(it => { it.dx -= esq; });
      cx -= esq;
      return { tipo: 'linha', itens, w: dir - esq, h: C.H + C.GY + Math.max(...itens.map(it => it.h)), cx };
    }
    function emLinhas(itens) {
      const nLinhas = Math.ceil(itens.length / C.QUEBRA);
      const porLinha = Math.ceil(itens.length / nLinhas);
      const linhas = [];
      let y = C.H + C.GY, largura = C.W;
      for (let i = 0; i < itens.length; i += porLinha) {
        const linha = itens.slice(i, i + porLinha);
        let x = C.RECUO;
        linha.forEach(it => { it.dx = x; it.dy = y; x += it.w + C.GX; });
        largura = Math.max(largura, x - C.GX);
        linhas.push({ y, itens: linha });
        y += Math.max(...linha.map(it => it.h)) + C.GY;
      }
      return { tipo: 'linhas', itens, linhas, w: largura, h: y - C.GY, cx: 0 };
    }
    const pos = new Map();
    const fios = [];
    function posicionar(no, x, y) {
      const c = caixas.get(no.id);
      pos.set(no.id, { x: x + c.cx, y });
      if (c.tipo === 'pendurado') colocarBloco(c.bloco, x + c.bloco.dx, y + c.bloco.dy);
      if (c.tipo === 'linha' || c.tipo === 'linhas') c.itens.forEach(it => {
        if (it.tipo === 'no') posicionar(it.no, x + it.dx, y + it.dy);
        else colocarBloco(it, x + it.dx, y + it.dy);
      });
    }
    function colocarBloco(b, x, y) {
      b.x = x; b.y = y;
      b.cols.forEach((col, j) => col.forEach((f, i) => {
        pos.set(f.id, { x: x + j * (C.RECUO + C.W + C.COLUNA) + C.RECUO, y: y + C.TOPO + i * (C.H + C.LINHA) });
      }));
    }
    function fiosDe(no) {
      const c = caixas.get(no.id);
      const p = pos.get(no.id);
      const pe = p.y + C.H;                    // pé do cartão do pai
      if (c.tipo === 'pendurado') {
        ligarBloco(no, c.bloco, [[p.x + C.TRILHO, pe]]);
      } else if (c.tipo === 'linha') {
        const sx = p.x + C.W / 2, barra = pe + C.GY / 2;
        c.itens.forEach(it => {
          const inicio = [[sx, pe], [sx, barra]];
          if (it.tipo === 'no') { const f = pos.get(it.no.id); fio(no, it.no, inicio.concat([[f.x + C.W / 2, barra], [f.x + C.W / 2, f.y]])); }
          else ligarBloco(no, it, inicio.concat([[it.x + it.ax, barra]]));
        });
      } else if (c.tipo === 'linhas') {
        const tx = p.x + C.TRILHO;
        c.linhas.forEach(l => {
          const barra = p.y + l.y - C.GY / 2;
          l.itens.forEach(it => {
            const inicio = [[tx, pe], [tx, barra]];
            if (it.tipo === 'no') { const f = pos.get(it.no.id); fio(no, it.no, inicio.concat([[f.x + C.W / 2, barra], [f.x + C.W / 2, f.y]])); }
            else ligarBloco(no, it, inicio.concat([[it.x + it.ax, barra]]));
          });
        });
      }
      op.filhos(no).forEach(f => { if (caixas.get(f.id)) fiosDe(f); });
    }
    function ligarBloco(pai, b, inicio) {
      b.cols.forEach((col, j) => {
        const trilho = b.x + j * (C.RECUO + C.W + C.COLUNA) + C.TRILHO;
        col.forEach(f => {
          const q = pos.get(f.id), meio = q.y + C.H / 2;
          fio(pai, f, inicio.concat([[b.x + C.TRILHO, b.y], [trilho, b.y], [trilho, meio], [q.x, meio]]));
        });
      });
    }
    function fio(pai, filho, pontos) { fios.push({ de: pai.id, para: filho.id, d: caminho(pontos) }); }
    let x = 0, alt = 0;
    op.raizes.forEach(r => {
      const c = medir(r);
      posicionar(r, x, 0);
      x += c.w + C.GX * 2;
      alt = Math.max(alt, c.h);
    });
    op.raizes.forEach(fiosDe);
    return { pos, fios, w: Math.max(0, x - C.GX * 2), h: alt };
  }
  function caminho(pontos) {
    const q = [];
    pontos.forEach(pt => {
      const n = q.length;
      if (n && q[n - 1][0] === pt[0] && q[n - 1][1] === pt[1]) return;
      if (n >= 2) {
        const a = q[n - 2], b = q[n - 1];
        if ((a[0] === b[0] && b[0] === pt[0]) || (a[1] === b[1] && b[1] === pt[1])) { q[n - 1] = pt; return; }
      }
      q.push(pt);
    });
    const r1 = v => Math.round(v * 10) / 10;
    let d = 'M' + r1(q[0][0]) + ' ' + r1(q[0][1]);
    for (let i = 1; i < q.length; i++) {
      const [x, y] = q[i];
      if (i === q.length - 1) { d += 'L' + r1(x) + ' ' + r1(y); break; }
      const [x0, y0] = q[i - 1], [x2, y2] = q[i + 1];
      const r = Math.min(C.RAIO, Math.hypot(x - x0, y - y0) / 2, Math.hypot(x2 - x, y2 - y) / 2);
      d += 'L' + r1(x - Math.sign(x - x0) * r) + ' ' + r1(y - Math.sign(y - y0) * r) +
        'Q' + r1(x) + ' ' + r1(y) + ' ' + r1(x + Math.sign(x2 - x) * r) + ' ' + r1(y + Math.sign(y2 - y) * r);
    }
    return d;
  }
  return { calcular, C };
})();
window.CAMERA = function (tela, mundo, opcoes) {
  'use strict';
  const ZMIN = 0.05, ZMAX = 2.4;
  const cam = { x: 0, y: 0, z: 1, arrastou: false };
  const util = () => {
    const tira = opcoes.larguraPainel ? opcoes.larguraPainel() : 0;
    return { w: Math.max(80, tela.clientWidth - tira), h: tela.clientHeight };
  };
  function aplicar(animar) {
    mundo.classList.toggle('animando', !!animar);
    mundo.style.transform = 'translate(' + cam.x + 'px,' + cam.y + 'px) scale(' + cam.z + ')';
    const passo = Math.max(6, 24 * cam.z);
    tela.style.backgroundSize = passo + 'px ' + passo + 'px';
    tela.style.backgroundPosition = cam.x + 'px ' + cam.y + 'px';
    if (opcoes.aoMudar) opcoes.aoMudar(cam);
  }
  function zoomEm(z, cx, cy, animar) {
    z = Math.min(ZMAX, Math.max(ZMIN, z));
    const wx = (cx - cam.x) / cam.z, wy = (cy - cam.y) / cam.z;
    cam.z = z; cam.x = cx - wx * z; cam.y = cy - wy * z;
    aplicar(animar);
  }
  function zoomNoCentro(fator) { const u = util(); zoomEm(cam.z * fator, u.w / 2, u.h / 2, true); }
  const TOPO_LIVRE = 52, BASE_LIVRE = 56;
  function enquadrar(cx, op) {
    op = op || {};
    const u = util(), folga = op.folga == null ? 48 : op.folga, alt = u.h - TOPO_LIVRE - BASE_LIVRE;
    const z = Math.min(op.zMax || 1, Math.max(ZMIN, Math.min((u.w - folga * 2) / Math.max(cx.w, 1), (alt - folga * 2) / Math.max(cx.h, 1))));
    cam.z = z;
    cam.x = (u.w - cx.w * z) / 2 - cx.x * z;
    cam.y = TOPO_LIVRE + Math.max(folga, (alt - cx.h * z) / 2) - cx.y * z;
    aplicar(op.animar);
  }
  function centrarEm(px, py, zMin, animar) {
    const u = util();
    cam.z = Math.min(ZMAX, Math.max(cam.z, zMin || 0));
    cam.x = u.w / 2 - px * cam.z; cam.y = u.h / 2 - py * cam.z;
    aplicar(animar);
  }
  const ponteiros = new Map();
  let inicio = null, pinca = null;
  const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
  tela.addEventListener('pointerdown', e => {
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    if (e.target.closest('.flutua, .legenda, .pilula')) return; // controle não arrasta
    ponteiros.set(e.pointerId, { x: e.clientX, y: e.clientY });
    cam.arrastou = false;
    if (ponteiros.size === 1) inicio = { px: e.clientX, py: e.clientY, x: cam.x, y: cam.y };
    if (ponteiros.size === 2) { const [a, b] = [...ponteiros.values()]; pinca = { d: dist(a, b) || 1, z: cam.z }; }
  });
  tela.addEventListener('pointermove', e => {
    if (!ponteiros.has(e.pointerId)) return;
    ponteiros.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (ponteiros.size === 2 && pinca) {
      const [a, b] = [...ponteiros.values()], r = tela.getBoundingClientRect();
      cam.arrastou = true;
      zoomEm(pinca.z * dist(a, b) / pinca.d, (a.x + b.x) / 2 - r.left, (a.y + b.y) / 2 - r.top);
      return;
    }
    if (!inicio) return;
    const dx = e.clientX - inicio.px, dy = e.clientY - inicio.py;
    if (!cam.arrastou && Math.hypot(dx, dy) < 5) return; // tremidinha de clique não é arrasto
    if (!cam.arrastou) {
      cam.arrastou = true;
      tela.classList.add('arrastando');
      try { tela.setPointerCapture(e.pointerId); } catch (erro) { /* ponteiro já saiu: tudo bem */ }
    }
    cam.x = inicio.x + dx; cam.y = inicio.y + dy;
    aplicar(false);
  });
  function soltar(e) {
    ponteiros.delete(e.pointerId);
    if (ponteiros.size < 2) pinca = null;
    if (ponteiros.size === 1) { const p = [...ponteiros.values()][0]; inicio = { px: p.x, py: p.y, x: cam.x, y: cam.y }; }
    if (!ponteiros.size) { inicio = null; tela.classList.remove('arrastando'); }
  }
  tela.addEventListener('pointerup', soltar);
  tela.addEventListener('pointercancel', soltar);
  tela.addEventListener('click', e => { if (cam.arrastou) { e.stopPropagation(); e.preventDefault(); cam.arrastou = false; } }, true);
  tela.addEventListener('scroll', () => {
    if (!tela.scrollLeft && !tela.scrollTop) return;
    cam.x -= tela.scrollLeft; cam.y -= tela.scrollTop;
    tela.scrollLeft = 0; tela.scrollTop = 0;
    aplicar(false);
  });
  tela.addEventListener('wheel', e => {
    e.preventDefault();
    if (e.deltaX && !e.ctrlKey) { cam.x -= e.deltaX; cam.y -= e.deltaY; aplicar(false); return; }
    const r = tela.getBoundingClientRect();
    const fator = Math.exp(-e.deltaY * (e.deltaMode === 1 ? 0.05 : e.ctrlKey ? 0.01 : 0.0016));
    zoomEm(cam.z * fator, e.clientX - r.left, e.clientY - r.top);
  }, { passive: false });
  function andar(dx, dy) { cam.x += dx; cam.y += dy; aplicar(true); }
  function zoomCem() { const u = util(); zoomEm(1, u.w / 2, u.h / 2, true); }
  return { cam, aplicar, zoomEm, zoomNoCentro, enquadrar, centrarEm, andar, zoomCem, util };
};
window.VISUAL = (function () {
  'use strict';
  const I = window.I18N, T = I.T;
  const DIA = 864e5;
  const esc = s => String(s == null ? '' : s).replace(/[&<>""']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '""': '&quot;', ""'"": '&#39;' }[c]));
  const svg = (d, extra) => '<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round"" aria-hidden=""true""' + (extra || '') + '>' + d + '</svg>';
  const ICONES = {
    org: '<svg viewBox=""0 0 40 40"" aria-hidden=""true""><rect x=""14"" y=""7"" width=""12"" height=""8"" rx=""2.5"" fill=""currentColor""/><path d=""M20 15v5M9.5 20h21M9.5 20v5M20 20v5M30.5 20v5"" stroke=""currentColor"" stroke-width=""1.6"" fill=""none"" opacity="".7""/><rect x=""5"" y=""25"" width=""9"" height=""8"" rx=""2.5"" fill=""currentColor"" opacity="".85""/><rect x=""15.5"" y=""25"" width=""9"" height=""8"" rx=""2.5"" fill=""currentColor"" opacity="".85""/><rect x=""26"" y=""25"" width=""9"" height=""8"" rx=""2.5"" fill=""currentColor"" opacity="".85""/></svg>',
    busca: svg('<circle cx=""11"" cy=""11"" r=""7""/><path d=""M20 20l-4-4""/>'),
    bolo: svg('<path d=""M4 21h16M5 21v-7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7""/><path d=""M5 16c1.5 1 3 1 4.5 0s3-1 4.5 0 3 1 4.5 0""/><path d=""M12 12V8""/><path d=""M12 5.5c.8-.6.8-1.6 0-2.5-.8.9-.8 1.9 0 2.5z""/>'),
    novo: svg('<path d=""M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z""/>'),
    maleta: svg('<rect x=""3"" y=""7"" width=""18"" height=""13"" rx=""2""/><path d=""M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2""/>'),
    baixar: svg('<path d=""M12 4v11M7 10l5 5 5-5M5 20h14""/>'),
    imprimir: svg('<path d=""M7 9V3h10v6""/><rect x=""3"" y=""9"" width=""18"" height=""8"" rx=""2""/><path d=""M7 14h10v7H7z""/>'),
    subir: svg('<path d=""M12 15V4M7 9l5-5 5 5M5 20h14""/>'),
    mais: svg('<path d=""M12 6v12M6 12h12""/>', ' class=""ic-p""'),
    menos: svg('<path d=""M6 12h12""/>', ' class=""ic-p""'),
    direita: svg('<path d=""M9 6l6 6-6 6""/>', ' class=""ic-p""'),
    baixo: svg('<path d=""M6 9l6 6 6-6""/>', ' class=""ic-p""')
  };
  function iniciais(nome) {
    const p = String(nome || '').trim().split(/\s+/).filter(Boolean);
    if (!p.length) return '?';
    return (p[0][0] + (p.length > 1 ? p[p.length - 1][0] : '')).toUpperCase();
  }
  const dataTxt = d => d ? d.toLocaleDateString(I.locale(), { day: '2-digit', month: '2-digit', year: 'numeric' }) : '-';
  const diaMes = a => a ? new Date(2000, a.m - 1, a.d).toLocaleDateString(I.locale(), { day: '2-digit', month: '2-digit' }) : '';
  const dias = (de, ate) => Math.max(0, Math.round((ate - de) / DIA));
  function tempo(adm, ref) {
    if (!adm) return '';
    let meses = (ref.getFullYear() - adm.getFullYear()) * 12 + (ref.getMonth() - adm.getMonth());
    if (ref.getDate() < adm.getDate()) meses -= 1;
    if (meses < 1) return T('t_dias', { d: dias(adm, ref) });
    const a = Math.floor(meses / 12), m = meses % 12;
    if (!a) return m === 1 ? T('t_mes') : T('t_meses', { m });
    if (!m) return a === 1 ? T('t_ano') : T('t_anos', { a });
    return T('t_anos_meses', { a, m });
  }
  const nomeDe = n => n.tipo === 'vaga' ? T('vaga') : n.nome;
