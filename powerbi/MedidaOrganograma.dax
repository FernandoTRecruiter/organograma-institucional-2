    $('imp-cab').textContent = (org.empresa ? org.empresa + ' · ' : '') + T('numeros_de') + ' ' + V.dataTxt(org.dataRef) +
      (filtros.length ? ' · ' + T('filtros_ativos') + ': ' + filtros.join(', ') : '') + ' · ' + T('impresso_em', { d: V.dataTxt(new Date()) });
