      const f = arq.files && arq.files[0];
      if (!f) return;
      const leitor = new FileReader();
      leitor.onload = () => { $('md-texto').value = String(leitor.result || ''); carregar(); };
      leitor.readAsText(f, 'utf-8');
    });
  }
