    const andar = n => { if (todos || visao.casa.has(n.id)) out.push(n); (org.filhos.get(n.id) || []).forEach(andar); };
    org.raizes.forEach(andar);
    return out;
  }
  const textoCsv = todos => E.paraCsv(org, nosEmOrdem(todos), I.nome, I.lang);
