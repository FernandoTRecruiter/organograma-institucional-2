    if (!cx) return;
    const cabe = c.x + cx.x * c.z >= 0 && c.y + cx.y * c.z >= 0 && c.x + (cx.x + cx.w) * c.z <= u.w && c.y + (cx.y + cx.h) * c.z <= u.h;
